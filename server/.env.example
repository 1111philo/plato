# Copy to .env and fill in your values.
# .env is gitignored — your local config won't be committed.

# plato calls its AI model through Amazon Bedrock, in dev and in production.
# Any standard AWS credential source works — AWS_PROFILE, `aws sso login`, or
# the explicit keys below. The credentials need bedrock:InvokeModel and
# bedrock:InvokeModelWithResponseStream, and model access enabled for
# qwen.qwen3-vl-235b-a22b.

AWS_REGION=us-east-2

# Option A — a named profile / SSO session you've already logged into:
# AWS_PROFILE=your-profile

# Option B — explicit keys:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
